{
  "moderation": {
    "anyOf": [
      {
        "$ref": "#/definitions/AgentMessageModeration"
      },
      {
        "type": "null"
      }
    ],
    "default": null
  },
  "definitions": {
    "AgentMessageDisplay": {
      "description": "How Chat should present a recovered answer.",
      "oneOf": [
        {
          "properties": {
            "annotation": {
              "anyOf": [
                {
                  "$ref": "#/definitions/AnswerAnnotation"
                },
                {
                  "type": "null"
                }
              ]
            },
            "mode": {
              "enum": [
                "show"
              ],
              "type": "string"
            },
            "trustedContacts": {
              "$ref": "#/definitions/TrustedContacts"
            },
            "version": {
              "enum": [
                1
              ],
              "format": "uint8",
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "mode",
            "trustedContacts",
            "version"
          ],
          "type": "object"
        },
        {
          "properties": {
            "mode": {
              "enum": [
                "hide"
              ],
              "type": "string"
            },
            "replacement": {
              "$ref": "#/definitions/AnswerReplacement"
            },
            "version": {
              "enum": [
                1
              ],
              "format": "uint8",
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "mode",
            "replacement",
            "version"
          ],
          "type": "object"
        },
        {
          "properties": {
            "mode": {
              "enum": [
                "block"
              ],
              "type": "string"
            },
            "reason": {
              "$ref": "#/definitions/BlockReason"
            },
            "version": {
              "enum": [
                1
              ],
              "format": "uint8",
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "mode",
            "reason",
            "version"
          ],
          "type": "object"
        }
      ]
    },
    "AgentMessageModeration": {
      "properties": {
        "display": {
          "anyOf": [
            {
              "$ref": "#/definitions/AgentMessageDisplay"
            },
            {
              "type": "null"
            }
          ]
        },
        "moderated": {
          "type": "boolean"
        }
      },
      "required": [
        "moderated"
      ],
      "type": "object"
    },
    "AnswerAnnotation": {
      "oneOf": [
        {
          "properties": {
            "kind": {
              "enum": [
                "wellbeingHelpline"
              ],
              "type": "string"
            },
            "subject": {
              "$ref": "#/definitions/HelplineSubject"
            }
          },
          "required": [
            "kind",
            "subject"
          ],
          "type": "object"
        }
      ]
    },
    "AnswerReplacement": {
      "oneOf": [
        {
          "properties": {
            "kind": {
              "enum": [
                "wellbeingPromptHelpline"
              ],
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "title": "WellbeingPromptHelplineAnswerReplacement",
          "type": "object"
        }
      ]
    },
    "BlockReason": {
      "oneOf": [
        {
          "properties": {
            "kind": {
              "enum": [
                "protection"
              ],
              "type": "string"
            },
            "protectionType": {
              "description": "Identifies the same moderation row that Chat writes on the live path.",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "protectionType"
          ],
          "type": "object"
        },
        {
          "properties": {
            "kind": {
              "enum": [
                "cyber"
              ],
              "type": "string"
            },
            "trustedAccess": {
              "type": [
                "boolean",
                "null"
              ]
            }
          },
          "required": [
            "kind"
          ],
          "title": "KindBlockReason",
          "type": "object"
        }
      ]
    },
    "HelplineSubject": {
      "enum": [
        "answer",
        "prompt"
      ],
      "type": "string"
    },
    "TrustedContacts": {
      "enum": [
        "check",
        "skip"
      ],
      "type": "string"
    }
  }
}
